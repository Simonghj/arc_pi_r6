# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.

# Model endpoint (any OpenAI-compatible /chat/completions API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.arc-bench.com/v1
MODEL=deepseek-v4-flash-vision-exp

# Vision model(key and URL fall back to the OPENAI_* values)
VISUAL_MODEL=deepseek-v4-flash-vision-exp
VISUAL_API_KEY=
VISUAL_BASE_URL=https://api.arc-bench.com/v1

# Recommended settings (our hackathon final tuned values)
PI_REASONING=high
PI_REVIEWER=self
PI_CONTEXT_TOKENS=120000
PI_TIME_BUDGET_SECONDS=18000
PI_FINAL_PHASE_SECONDS=3600
PI_PROMPT_SECONDS=900
PI_BATCH_REVIEW=0
PI_SECONDS_PER_BATCH=1300
PI_BLIND_TEST=0
PI_FINAL_REVIEW=0
PI_REPAIR_ROUNDS=3
